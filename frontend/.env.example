# Backend API URL (set to your Render or local backend URL)
# For local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# For Vercel (set this in Vercel dashboard under Project Settings > Environment Variables):
# NEXT_PUBLIC_API_URL=https://your-render-backend.onrender.com

# For Cloudflare Pages (set in wrangler.toml or Cloudflare dashboard):
# NEXT_PUBLIC_API_URL=https://your-render-backend.onrender.com

# Set to 'true' ONLY for Cloudflare Pages static export build
# NEXT_EXPORT=true
